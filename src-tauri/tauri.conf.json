{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notor",
  "version": "0.1.0",
  "identifier": "app.notor.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Minimal note-taking & PKM",
    "longDescription": "Notor is an open-source markdown note-taking app for macOS. Plain files, native speed, beautiful by default.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
